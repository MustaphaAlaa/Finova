
# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files for dependency restore
COPY ["Host/Finova.API/Finova.API.csproj", "Host/Finova.API/"]
 

COPY ["Host/Finova.Workers/OutboxWorker/OutboxWorker.csproj", "Host/Finova.Workers/OutboxWorker/"]

# Banks Module

COPY ["Modules/Banks.Module/Application/Banks.Application.csproj", "Modules/Banks.Module/Application/"]

COPY ["Modules/Banks.Module/Contracts/Banks.Contracts.csproj", "Modules/Banks.Module/Contracts/"]

COPY ["Modules/Banks.Module/Domain/Banks.Domain.csproj", "Modules/Banks.Module/Domain/"]

COPY ["Modules/Banks.Module/Infrastructure/Banks.Infrastructure.csproj", "Modules/Banks.Module/Infrastructure/"]

COPY ["Modules/Banks.Module/Presentation/Banks.Presentation.csproj", "Modules/Banks.Module/Presentation/"]


# Identity Module

COPY ["Modules/Identity.Module/Application/Identity.Application.csproj", "Modules/Identity.Module/Application/"]

COPY ["Modules/Identity.Module/Contracts/Identity.Contracts.csproj", "Modules/Identity.Module/Contracts/"]

COPY ["Modules/Identity.Module/Domain/Identity.Domain.csproj", "Modules/Identity.Module/Domain/"]

COPY ["Modules/Identity.Module/Infrastructure/Identity.Infrastructure.csproj", "Modules/Identity.Module/Infrastructure/"]

COPY ["Modules/Identity.Module/Presentation/Identity.Presentation.csproj", "Modules/Identity.Module/Presentation/"]

#Transactions Module


COPY ["Modules/Transactions.Module/Application/Transactions.Application.csproj", "Modules/Transactions.Module/Application/"]

COPY ["Modules/Transactions.Module/Contracts/Transactions.Contracts.csproj", "Modules/Transactions.Module/Contracts/"]

COPY ["Modules/Transactions.Module/Domain/Transactions.Domain.csproj", "Modules/Transactions.Module/Domain/"]

COPY ["Modules/Transactions.Module/Infrastructure/Transactions.Infrastructure.csproj", "Modules/Transactions.Module/Infrastructure/"]

COPY ["Modules/Transactions.Module/Presentation/Transaction.Presentation.csproj", "Modules/Transactions.Module/Presentation/"]


COPY ["Shared/Shared.csproj", "Shared/"]
 
 
RUN dotnet restore "Host/Finova.API/Finova.API.csproj"

# Copy source and publish
COPY Host/ Host/
COPY Modules/ Modules/
COPY Shared/ Shared/

RUN dotnet publish "Host/Finova.API/Finova.API.csproj" \
    -c Release \ 
    -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "Finova.API.dll"]
